---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/utils/constants';
import { DOCS, NOT_IN_FOLDER, DOC_PACKAGE, VERIFY_STEPS, CERT_FAQS } from '@/data/certifications';

// 目前仅英文版；其他语言待翻译后加入此数组（届时 hreflang 会自动补全）
const AVAILABLE = ['en'];

export function getStaticPaths() {
  return (['en'] as const).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const pageTitle = 'Certifications & Compliance — Verify Every Claim';
const pageDesc =
  'ISO 13485 (8623138319), ISO 9001 (8629985173), EU GPSR certificate TQT1520D368EC, RoHS reports RC2503200748 and RC2503200997, and EUIPO design 015134442-0001 — with the number, the issuer and the exact steps to check each one.';

const GROUPS = [
  { type: 'qms', label: 'Quality management system', lead: 'How the factory is run.' },
  { type: 'product', label: 'Product conformity', lead: 'What was tested, on which model, to which standard.' },
  { type: 'ip', label: 'Intellectual property', lead: 'What is protected, and where.' },
] as const;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: pageTitle,
      description: pageDesc,
      url: `${SITE.url}/${locale}/certifications/`,
      about: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/${locale}/` },
        { '@type': 'ListItem', position: 2, name: 'Certifications', item: `${SITE.url}/${locale}/certifications/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: CERT_FAQS.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title="Certifications & Compliance"
  seoTitle={`Certifications & Compliance — Verify Every Claim | ${SITE.name}`}
  description={pageDesc}
  locale={locale!}
  availableLocales={AVAILABLE}
  schema={schema}
>
  <div class="container-main section-padding">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-neutral-500 mb-8" aria-label="Breadcrumb">
      <a href={`/${locale}/`} class="hover:text-primary-600">Home</a>
      <span>/</span>
      <span class="text-neutral-800 font-medium">Certifications</span>
    </nav>

    <!-- Hero -->
    <div class="max-w-3xl mb-12">
      <h1 class="mb-5">Certifications &amp; Compliance</h1>
      <p class="text-lg text-neutral-600 leading-relaxed">
        Every document below carries a number you can check with the body that issued it — the
        certificate number, the report number, the design registration number. Nothing on this page
        asks you to trust a badge.
      </p>
      <p class="text-neutral-600 leading-relaxed mt-3">
        We also list what is <strong>not</strong> in the folder, because that is the part buyers
        normally discover after the deposit.
      </p>
    </div>

    <!-- 四步核验 -->
    <section class="mb-16">
      <h2 class="mb-2 text-2xl">How to verify a Chinese supplier in four steps</h2>
      <p class="text-neutral-600 mb-8 max-w-2xl">
        The same checklist we expect our own buyers to run on us. Twenty minutes, and it filters out
        most of the documentation problems you would otherwise find after payment.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {VERIFY_STEPS.map((s) => (
          <div class="bg-white border border-neutral-200 rounded-xl p-6">
            <div class="flex items-start gap-3">
              <span class="w-8 h-8 rounded-lg bg-primary-600 text-white text-sm font-bold flex items-center justify-center shrink-0">{s.step}</span>
              <div>
                <h3 class="text-base font-semibold text-neutral-900 mb-1.5">{s.title}</h3>
                <p class="text-sm text-neutral-600 leading-relaxed">{s.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 文档明细（分组） -->
    {GROUPS.map((g) => {
      const items = DOCS.filter((d) => d.type === g.type);
      if (items.length === 0) return null;
      return (
        <section class="mb-14">
          <div class="border-b border-neutral-200 pb-3 mb-6">
            <h2 class="text-xl m-0">{g.label}</h2>
            <p class="text-sm text-neutral-500 mt-1 mb-0">{g.lead}</p>
          </div>

          <div class="space-y-5">
            {items.map((d) => (
              <div class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
                <div class="px-6 py-5 border-b border-neutral-100 bg-neutral-50 flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <h3 class="text-base font-semibold text-neutral-900 leading-snug">{d.title}</h3>
                    <p class="text-xs text-neutral-500 mt-1">{d.issuer}</p>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="inline-block font-mono text-xs bg-white border border-neutral-200 rounded px-2.5 py-1 text-neutral-800">
                      No. {d.number}
                    </span>
                    <p class="text-[11px] text-neutral-500 mt-1.5 tabular-nums">
                      Issued {d.issued}{d.validUntil ? ` · valid to ${d.validUntil}` : ''}
                    </p>
                  </div>
                </div>

                <div class="px-6 py-5">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                      <h4 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-1.5">Standard / basis</h4>
                      <p class="text-sm text-neutral-800 leading-relaxed">{d.standard}</p>

                      <h4 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-1.5 mt-4">Covers</h4>
                      <p class="text-sm text-neutral-700 leading-relaxed">{d.covers}</p>
                    </div>

                    <div>
                      <h4 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-1.5">What it is</h4>
                      <p class="text-sm text-neutral-700 leading-relaxed">{d.whatItIs}</p>

                      {d.whatItIsNot && (
                        <div class="mt-4 border-l-2 border-amber-300 pl-3">
                          <h4 class="text-xs font-semibold uppercase tracking-wide text-amber-700 mb-1">What it is not</h4>
                          <p class="text-sm text-neutral-700 leading-relaxed">{d.whatItIsNot}</p>
                        </div>
                      )}
                    </div>
                  </div>

                  <div class="mt-5 pt-4 border-t border-neutral-100">
                    <h4 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-1.5">How to check it yourself</h4>
                    <p class="text-sm text-neutral-700 leading-relaxed">{d.verify}</p>
                    {d.verifyUrl && (
                      <a href={d.verifyUrl} target="_blank" rel="noopener" class="inline-block mt-2 text-xs font-medium text-primary-600 hover:text-primary-700">
                        Open the public register →
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      );
    })}

    <!-- 没有的东西 -->
    <section class="mb-16">
      <h2 class="mb-2 text-2xl">What is not in this folder</h2>
      <p class="text-neutral-600 mb-6 max-w-2xl">
        Being specific about what we do not hold is the fastest way for you to work out whether we
        are the right supplier for your market.
      </p>
      <div class="bg-amber-50/60 border border-amber-200 rounded-xl overflow-hidden">
        <table class="w-full">
          <tbody>
            {NOT_IN_FOLDER.map((n) => (
              <tr class="border-b border-amber-100 last:border-0 align-top">
                <td class="px-5 py-4 w-1/3">
                  <div class="text-sm font-medium text-neutral-900">{n.name}</div>
                  <span class="inline-block mt-1.5 text-[11px] font-semibold bg-amber-100 text-amber-800 rounded px-2 py-0.5">{n.status}</span>
                </td>
                <td class="px-5 py-4 text-sm text-neutral-700 leading-relaxed">{n.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 随货文件包 -->
    <section class="mb-16 bg-neutral-50 rounded-2xl p-8">
      <h2 class="mb-2 text-2xl">Documents that ship with every order</h2>
      <p class="text-neutral-600 mb-6 max-w-2xl">
        Not “available on request after payment” — these reach you before the vessel sails.
      </p>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {DOC_PACKAGE.map((d) => (
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-sm text-neutral-700"><span class="font-medium text-neutral-900">{d.name}</span> — {d.desc}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- FAQ -->
    <section class="mb-16">
      <h2 class="mb-6 text-2xl">Questions buyers ask about this page</h2>
      <div class="space-y-3 max-w-3xl">
        {CERT_FAQS.map((f) => (
          <details class="group bg-white border border-neutral-200 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-4 cursor-pointer hover:bg-neutral-50 transition-colors list-none">
              <span class="font-medium text-neutral-900 pr-4">{f.question}</span>
              <span class="text-neutral-400 group-open:rotate-180 transition-transform shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-4 text-sm text-neutral-600 leading-relaxed">{f.answer}</div>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-primary-700 rounded-2xl p-8 md:p-10 text-white">
      <h2 class="text-2xl mb-3 text-white">Want the document package for your market?</h2>
      <p class="text-white/80 mb-6 max-w-2xl">
        Tell us the destination country and the model. We send the certificate copies, the
        declaration of conformity and the label version your customs broker will ask for — and we
        tell you which document does not cover that model, if any.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={`/${locale}/get-quote/`} class="btn-accent">Request the document package →</a>
        <a href={`/${locale}/contact/`} class="btn-outline !border-white !text-white hover:!bg-white hover:!text-primary-700">Talk to a specialist</a>
      </div>
    </section>
  </div>
</BaseLayout>
