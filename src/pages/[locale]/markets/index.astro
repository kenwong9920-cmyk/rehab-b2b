---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, FACTS } from '@/utils/constants';
import { MARKETS } from '@/data/markets';

const AVAILABLE = ['en'];

export function getStaticPaths() {
  return (['en'] as const).map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const pageDesc =
  'Rehabilitation equipment manufacturing for North America, Europe, the UK, Japan & Korea and the Middle East — compliance documents, registration responsibilities, logistics and the pitfalls per market.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'Export Markets',
      description: pageDesc,
      url: `${SITE.url}/${locale}/markets/`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/${locale}/` },
        { '@type': 'ListItem', position: 2, name: 'Export Markets', item: `${SITE.url}/${locale}/markets/` },
      ],
    },
  ],
};
---

<BaseLayout
  title="Export Markets"
  seoTitle={`Export Markets — Compliance & Logistics by Region | ${SITE.name}`}
  description={pageDesc}
  locale={locale!}
  availableLocales={AVAILABLE}
  schema={schema}
>
  <div class="container-main section-padding">
    <nav class="flex items-center gap-2 text-sm text-neutral-500 mb-8" aria-label="Breadcrumb">
      <a href={`/${locale}/`} class="hover:text-primary-600">Home</a>
      <span>/</span>
      <span class="text-neutral-800 font-medium">Export Markets</span>
    </nav>

    <div class="max-w-3xl mb-14">
      <h1 class="mb-5">Manufacturing for your market, not for a generic one</h1>
      <p class="text-lg text-neutral-600 leading-relaxed">
        The product is the same; the paperwork is not. A shower chair shipped to Rotterdam needs a
        Declaration of Conformity and an EUDAMED entry, the same chair shipped to Jebel Ali needs
        Arabic labelling and an attested certificate set. Choose your market below and see exactly
        what is required, who files it, and how the goods get there.
      </p>
    </div>

    <!-- 市场网格 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-16">
      {MARKETS.map((m) => (
        <a
          href={`/${locale}/markets/${m.slug}/`}
          class="group block bg-white border border-neutral-200 rounded-xl p-7 hover:border-primary-300 hover:shadow-sm transition-all no-underline"
        >
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">{m.flag}</span>
            <h2 class="text-lg font-semibold text-neutral-900 group-hover:text-primary-700 transition-colors m-0">{m.name}</h2>
          </div>
          <p class="text-sm text-neutral-600 leading-relaxed mb-4">{m.description}</p>
          <div class="flex flex-wrap gap-1.5 mb-4">
            {m.docs.slice(0, 3).map((d) => (
              <span class="text-[11px] bg-neutral-100 text-neutral-600 rounded px-2 py-0.5">{d.document}</span>
            ))}
            <span class="text-[11px] text-neutral-400 px-1">+{Math.max(0, m.docs.length - 3)} more</span>
          </div>
          <span class="text-sm font-medium text-primary-600">View requirements →</span>
        </a>
      ))}
    </div>

    <!-- 通用说明 -->
    <section class="bg-neutral-50 rounded-2xl p-8 mb-16">
      <h2 class="mb-3 text-2xl">What is the same in every market</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {[
          `Production in ${FACTS.productionDays} after order confirmation — identical regardless of destination.`,
          `MOQ from ${FACTS.moqFrom} per SKU on selected models; the market does not change the minimum.`,
          'Batch inspection report and Declaration of Conformity with every shipment.',
          'Label artwork built for your market before production, not applied afterwards.',
        ].map((t) => (
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-accent-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span class="text-sm text-neutral-700">{t}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="bg-primary-700 rounded-2xl p-8 md:p-10 text-white">
      <h2 class="text-2xl mb-3 text-white">Tell us the destination, get the document list</h2>
      <p class="text-white/80 mb-6 max-w-2xl">
        Send the country and the product category. We reply with the documents your customs broker and
        regulator will ask for, and who has to file each one.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={`/${locale}/get-quote/`} class="btn-accent">Request the document list →</a>
        <a href={`/${locale}/certifications/`} class="btn-outline !border-white !text-white hover:!bg-white hover:!text-primary-700">See our certifications</a>
      </div>
    </section>
  </div>
</BaseLayout>
