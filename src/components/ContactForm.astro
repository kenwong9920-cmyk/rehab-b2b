---
// ContactForm — 通用联系表单
interface Props {
  productName?: string;
  showProductField?: boolean;
  showQuantityField?: boolean;
  source?: string;
}

const { productName = '', showProductField = false, showQuantityField = false, source } = Astro.props;
const locale = Astro.url.pathname.split('/')[1] || 'en';

// Derive source from prop, or infer from pathname
const formSource = source || (() => {
  const path = Astro.url.pathname;
  if (path.includes('/get-quote/')) return 'get-quote-page';
  if (path.includes('/contact/')) return 'contact-page';
  return path.replace(/^\/[a-z]{2}\//, '').replace(/\/$/, '') || 'page';
})();

