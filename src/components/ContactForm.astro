const c = COPY[locale] || COPY.en;
---

<form
  id="inquiry-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-5"
  data-msg-sending={c.sending}
  data-msg-success-title={c.successTitle}
  data-msg-success-body={c.successBody}
  data-msg-error={c.error}
>
  <!-- Web3Forms Access Key - Replace with your own -->
  <input type="hidden" name="access_key" value="f76d4663-7486-4058-a0b7-8c9e11cb5f79" />
  <input type="hidden" name="subject" value={`New Inquiry from JinDa Rehab Medical — ${productName || 'General'}`} />
  <input type="hidden" name="from_name" value="JinDa Rehab Medical Website" />
  {/* Honeypot anti-spam */}
  <input type="checkbox" name="botcheck" class="hidden" style="display:none;" />
  <input type="hidden" name="redirect" value="false" />

  {/* Tracking fields */}
  <input type="hidden" name="locale" value={locale} />
  <input type="hidden" name="source" value={formSource} />
  {productName && <input type="hidden" name="product_slug" value={productName} />}

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="name" class="block text-sm font-medium text-neutral-700 mb-1.5">
        {c.name} <span class="text-red-500">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-4 py-2.5 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow text-sm"
        placeholder={c.phName}
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-medium text-neutral-700 mb-1.5">
        {c.email} <span class="text-red-500">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-2.5 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow text-sm"
        placeholder={c.phEmail}
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="company" class="block text-sm font-medium text-neutral-700 mb-1.5">{c.company}</label>
      <input
        type="text"
        id="company"
        name="company"
        class="w-full px-4 py-2.5 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow text-sm"
        placeholder={c.phCompany}
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1.5">
        {c.phone}
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="w-full px-4 py-2.5 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow text-sm"
        placeholder={c.phPhone}
      />
    </div>
  </div>

  {showProductField && (
    <div>
      <label for="product" class="block text-sm font-medium text-neutral-700 mb-1.5">{c.product}</label>
      <input
        type="text"
        id="product"
        name="product"
        value={productName}
        class="w-full px-4 py-2.5 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow text-sm"
        placeholder={c.phProduct}
      />
    </div>
  )}

  {showQuantityField && (
    <div>
      <label for="quantity" class="block text-sm font-medium text-neutral-700 mb-1.5">{c.quantity}</label>
      <input
        type="text"
        id="quantity"
        name="quantity"
        class="w-full px-4 py-2.5 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow text-sm"
        placeholder={c.phQuantity}
      />
    </div>
  )}

  <div>
    <label for="message" class="block text-sm font-medium text-neutral-700 mb-1.5">
      {c.message} <span class="text-red-500">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      required
      class="w-full px-4 py-2.5 border border-neutral-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow text-sm resize-y"
      placeholder={c.phMessage}
    ></textarea>
  </div>

  <button type="submit" class="btn-accent w-full text-lg py-3.5">
    {c.submit}
  </button>

  <p class="text-xs text-neutral-400 text-center">
    {c.privacy}
  </p>
</form>

<script>
  // Simple form submission handler with feedback
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const originalText = btn?.textContent || 'Submit';
    // 本地化提示文案走 data-* 传递，避免在客户端脚本里写死英文
    const sendingText = form.dataset.msgSending || 'Sending...';
    const successTitle = form.dataset.msgSuccessTitle || 'Thank You!';
    const successBody = form.dataset.msgSuccessBody || 'We will contact you within 24 hours.';
    const errorText = form.dataset.msgError || 'Something went wrong. Please try again.';
    if (btn) {
      btn.textContent = sendingText;
      btn.disabled = true;
    }

    try {
      const formData = new FormData(form);

      // Append client-side tracking fields
      formData.append('page_url', window.location.href);
      const searchParams = new URLSearchParams(window.location.search);
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach((p) => {
        const val = searchParams.get(p);
        if (val) formData.append(p, val);
      });

      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
      });

      if (response.ok) {
        const box = document.createElement('div');
        box.className = 'text-center py-8';
        const icon = document.createElement('div');
        icon.className = 'text-4xl mb-4';
        icon.textContent = '✅';
        const h3 = document.createElement('h3');
        h3.className = 'text-xl font-semibold text-accent-700 mb-2';
        h3.textContent = successTitle;
        const p = document.createElement('p');
        p.className = 'text-neutral-600';
        p.textContent = successBody;
        box.append(icon, h3, p);
        form.replaceChildren(box);
      } else {
        throw new Error('Submission failed');
      }
    } catch {
      if (btn) {
        btn.textContent = originalText;
        btn.disabled = false;
      }
      alert(errorText);
    }
  });
</script>
